{
  "name": "macro-agent",
  "version": "0.2.0",
  "description": "Interact with multiple agents as if they were a single agent.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "multiagent": "./dist/cli/acp.js",
    "multiagent-cli": "./dist/cli/index.js",
    "multiagent-mcp": "./dist/cli/mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e-full-agents": "RUN_FULL_AGENT_TESTS=true vitest run --config vitest.e2e.config.ts",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "version:patch": "npm version patch && git push && git push --tags",
    "version:minor": "npm version minor && git push && git push --tags",
    "version:major": "npm version major && git push && git push --tags",
    "publish:npm": "npm run build && npm publish"
  },
  "keywords": [
    "multi-agent",
    "claude",
    "orchestration"
  ],
  "author": "Alex Ngai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexngai/macro-agent.git"
  },
  "devDependencies": {
    "@sudocode-ai/cli": "^0.1.19",
    "@sudocode-ai/types": "^0.1.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.25.3",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@multi-agent-protocol/sdk": "^0.1.12",
    "acp-factory": "^0.1.14",
    "agent-inbox": "^0.2.2",
    "better-sqlite3": "^12.5.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "express": "^5.2.1",
    "git-cascade": "^0.0.7",
    "js-yaml": "^4.1.1",
    "nanoid": "^5.0.0",
    "opentasks": "^0.0.3",
    "openteams": "^0.3.0",
    "swarm-dispatch": "^0.3.4",
    "unique-names-generator": "^4.7.1",
    "ws": "^8.20.0",
    "zod": "^4.2.1"
  },
  "peerDependencies": {
    "agentic-mesh": "*",
    "minimem": "*",
    "sessionlog": "*",
    "skill-tree": "*"
  },
  "peerDependenciesMeta": {
    "minimem": {
      "optional": true
    },
    "skill-tree": {
      "optional": true
    },
    "sessionlog": {
      "optional": true
    },
    "agentic-mesh": {
      "optional": true
    }
  }
}
