{
  "name": "macro-agent",
  "version": "0.0.11",
  "description": "Interact with multiple agents as if they were a single agent.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "multiagent": "./dist/cli/acp.js",
    "multiagent-cli": "./dist/cli/index.js",
    "multiagent-mcp": "./dist/cli/mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e-full-agents": "RUN_FULL_AGENT_TESTS=true vitest run --config vitest.e2e.config.ts",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags",
    "publish:npm": "npm run build && npm publish"
  },
  "keywords": [
    "multi-agent",
    "claude",
    "orchestration"
  ],
  "author": "Alex Ngai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexngai/macro-agent.git"
  },
  "devDependencies": {
    "@sudocode-ai/cli": "^0.1.19",
    "@sudocode-ai/types": "^0.1.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "supertest": "^7.1.4",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@multi-agent-protocol/sdk": "^0.0.8",
    "@sudocode-ai/claude-code-acp": "^0.13.8",
    "acp-factory": "^0.1.9",
    "better-sqlite3": "^12.5.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "dataplane": "^0.1.3",
    "express": "^5.2.1",
    "js-yaml": "^4.1.1",
    "nanoid": "^5.0.0",
    "tinybase": "^5.0.0",
    "ulid": "^3.0.2",
    "ws": "^8.18.3",
    "zod": "^4.2.1"
  }
}
