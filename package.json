{
  "name": "macro-agent",
  "version": "0.0.4",
  "description": "Interact with multiple agents as if they were a single agent.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "multiagent": "./dist/cli/index.js",
    "multiagent-mcp": "./dist/cli/mcp.js",
    "multiagent-acp": "./dist/cli/acp.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "RUN_E2E_TESTS=true npx tsx scripts/test-acp-integration.ts",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags",
    "publish:npm": "npm run build && npm publish"
  },
  "keywords": [
    "multi-agent",
    "claude",
    "orchestration"
  ],
  "author": "Alex Ngai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexngai/macro-agent.git"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "supertest": "^7.1.4",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "acp-factory": "^0.0.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "express": "^5.2.1",
    "nanoid": "^5.0.0",
    "tinybase": "^5.0.0",
    "ws": "^8.18.3",
    "zod": "^4.2.1"
  }
}
